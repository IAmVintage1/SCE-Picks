# --- Supabase project settings (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key - NEVER expose this to the browser.
# Only used in server-side API routes (app/api/**).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin login for /admin ---
# This is a simple shared admin password (Phase 1). Pick a strong one.
ADMIN_PASSWORD=change-me-to-something-strong

# Random secret used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
